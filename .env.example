# LocalPilot Environment Configuration
NODE_ENV=development
PORT=3000
WORKER_PORT=3001

# Database Configuration
DATABASE_URL=postgresql://localpilot:localpilot@localhost:5432/localpilot_dev
DATABASE_DIRECT_URL=postgresql://localpilot:localpilot@localhost:5432/localpilot_dev

# App Security
SESSION_SECRET=localpilot-development-session-secret-at-least-32-chars-long
INTEGRATION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage (R2 / S3 Compatible)
R2_ACCOUNT_ID=mock-r2-account-id
R2_ACCESS_KEY_ID=mock-r2-access-key
R2_SECRET_ACCESS_KEY=mock-r2-secret-key
R2_BUCKET_NAME=localpilot-media-dev
R2_PUBLIC_DOMAIN=https://media.localpilot.dev

# External Integrations (Keep unconfigured / empty until authorized)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
